# Change values below to real values, these are placeholders
DB_USER = "username"
DB_PASS = "password"
DB_HOST = "localhost"
DB_PORT = "5444"

LLM_BASE_URL = "https://my-base-url/api/v1"
LLM_API_KEY = "llm_api_key"
LLM_MODEL_NAME = "model_name"

# Optional explicit target-model settings for LightRAG benchmark runs.
# Each value falls back to the corresponding LLM_* variable when omitted.
# TARGET_LLM_BASE_URL = "https://my-base-url/api/v1"
# TARGET_LLM_API_KEY = "target_llm_api_key"
# TARGET_LLM_MODEL_NAME = "Qwen2.5-Coder-7B-Instruct"

# Optional keyword-extraction model. Leave these variables unset to use the
# same target model for retrieval and SQL generation in a controlled run.
# LIGHTRAG_LLM_BASE_URL = "https://my-base-url/api/v1"
# LIGHTRAG_LLM_API_KEY = "lightrag_llm_api_key"
# LIGHTRAG_LLM_MODEL_NAME = "model_name"

# MCP Text-to-SQL server. MCP_DB_NAME fixes the database exposed by the
# server; clients cannot supply a database URI. MCP_DB_URI is an optional
# alternative to DB_USER/DB_PASS/DB_HOST/DB_PORT.
MCP_DB_NAME = "financial"
# MCP_DB_URI = "postgresql+psycopg://username:password@localhost:5444/financial"

# Auto uses baseline when the complete schema is at most this many cl100k
# tokens. Above it, one LightRAG retrieval chooses compact or structural.
MCP_SCHEMA_TOKEN_THRESHOLD = "150"
MCP_VALIDATE_EXPLAIN = "true"
MCP_EXPLAIN_TIMEOUT_MS = "3000"

# Optional overrides. Defaults point to artifacts/lightrag/<MCP_DB_NAME> and
# artifacts/db_knowledge/<MCP_DB_NAME>_knowledge.json under the repository.
# MCP_LIGHTRAG_STORAGE_DIR = "artifacts/lightrag/financial"
# MCP_DB_KNOWLEDGE_PATH = "artifacts/db_knowledge/financial_knowledge.json"

# stdio is safest for a local MCP client. HTTP binds to localhost by default.
MCP_TRANSPORT = "stdio"
MCP_HOST = "127.0.0.1"
MCP_PORT = "8000"
