# Change values below to real values, these are placeholders
DB_USER = "username"
DB_PASS = "password"

LLM_BASE_URL = "https://my-base-url/api/v1"
LLM_API_KEY = "llm_api_key"
LLM_MODEL_NAME = "model_name"

# Optional explicit target-model settings for LightRAG benchmark runs.
# Each value falls back to the corresponding LLM_* variable when omitted.
# TARGET_LLM_BASE_URL = "https://my-base-url/api/v1"
# TARGET_LLM_API_KEY = "target_llm_api_key"
# TARGET_LLM_MODEL_NAME = "Qwen2.5-Coder-7B-Instruct"

# Optional keyword-extraction model. Leave these variables unset to use the
# same target model for retrieval and SQL generation in a controlled run.
# LIGHTRAG_LLM_BASE_URL = "https://my-base-url/api/v1"
# LIGHTRAG_LLM_API_KEY = "lightrag_llm_api_key"
# LIGHTRAG_LLM_MODEL_NAME = "model_name"
